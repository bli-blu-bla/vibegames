{
  "name": "vibegames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/build-tokens.ts",
    "sync:forms": "node scripts/sync-issue-forms.ts",
    "check": "node scripts/check.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gate": "npm run lint && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "howler": "^2.2.4",
    "motion": "^14.9.1",
    "nipplejs": "^1.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seedrandom": "^3.0.5",
    "trystero": "^0.26.0",
    "zustand": "^5.0.16",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.65.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "spdx-license-ids": "^3.0.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
